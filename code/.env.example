# Database (Supabase PostgreSQL transaction pooler)
DATABASE_URL=

# Supabase Public & Anon Keys
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=vibewall_signed

# App security & pepper
SCREEN_TOKEN_PEPPER=vibewall_screen_token_pepper_32_chars_secret
APP_ORIGIN=http://localhost:3000

# Limits
REPORT_AUTO_HIDE_THRESHOLD=3
PHOTO_COOLDOWN_SECONDS=20
NOTE_COOLDOWN_SECONDS=15

# Mock flag: set to true to force client & server in-memory mock when services are unavailable
NEXT_PUBLIC_USE_MOCK=true
